# Configuration for Universal Disk Health Monitor
# Copy this file to .env (chmod 600 .env) or ~/.config/disk-health-monitor/.env

# Target volume path (e.g. /Volumes/MyDrive or / for system drive). Leave empty to auto-detect first external volume.
DISK_HEALTH_VOLUME=

# Target device query (e.g. disk4, "External SSD", or serial number). Leave empty to auto-detect from volume.
DISK_HEALTH_DEVICE=

# Optional Telegram bot alerts (can also be configured in Cmd+, Settings UI and stored in macOS Keychain)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional threshold overrides (leave commented to use config.json or built-in defaults)
# TEMP_WARNING_CELSIUS=58
# TEMP_CRITICAL_CELSIUS=68
# DISK_USED_WARNING_PERCENT=85
# DISK_USED_CRITICAL_PERCENT=93
# MIN_FREE_SPACE_WARNING_GB=30
# MIN_FREE_SPACE_CRITICAL_GB=15

# Optional custom directories (defaults to ~/.config/disk-health-monitor and ./logs)
# DISK_HEALTH_CONFIG_DIR=
# DISK_HEALTH_LOGS_DIR=
